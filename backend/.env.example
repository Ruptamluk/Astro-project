# ── Backend (FastAPI) environment ───────────────────────────────
# Copy to backend/.env for local dev. In production (Render) set these in
# the service's Environment panel — Render does NOT read this file.

# MongoDB Atlas connection string (required — the default is a dummy and
# will not connect).
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/astrology

# Email OTP (Gmail or other SMTP). SMTP_HOST/PORT default to Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# Firebase project id for phone OTP (same project as the frontend).
FIREBASE_PROJECT_ID=

# Public URL of this backend (used in some links/callbacks).
BACKEND_URL=http://localhost:8000

# Razorpay keys — Dashboard > Settings > API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret — Dashboard > Settings > Webhooks.
# Must match the secret you set when creating the webhook that points to
# <backend>/api/payment/webhook (event: payment.captured).
RAZORPAY_WEBHOOK_SECRET=

# Optional: Twilio SMS OTP (only if you use phone OTP via Twilio).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
